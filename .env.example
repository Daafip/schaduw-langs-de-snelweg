# Copy to .env (untracked) and fill in your own key.
#
# Optional CARTO basemap API key used for the quick-look Folium map
# (see src/shaduw_langs_de_snelweg/outputs.py). Without it the map still
# renders using CartoDB's unauthenticated tiles, just subject to their
# anonymous-use rate limits. Get a key at https://carto.com/basemaps.
# In CI this is instead provided via the CARTO_API_KEY repository secret.
CARTO_API_KEY=
